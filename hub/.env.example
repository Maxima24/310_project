# Copy to hub/.env for running the hub directly (outside Docker).
# Docker Compose reads the ROOT .env instead — see ../.env.example.

# --- Required ---------------------------------------------------------------

# Credentials are split by role (roadmap item 2). All travel as
# `Authorization: Bearer <credential>`. The two below MUST differ — reusing one
# secret for both would give every agent host operator privileges, and the hub
# refuses to start in that case.

# Provisioning secret. Authorises POST /agents/register and NOTHING else.
# Every agent host needs it. In exchange for a token, each agent can then act only
# as itself: it cannot forge events for other sensors, arm/disarm, acknowledge
# alerts, or read history.
AGENT_BOOTSTRAP_KEY=dev-bootstrap-key-change-me

# Operator credential: arm/disarm, acknowledge alerts, read events/alerts/agents,
# and subscribe to the WebSocket feed. Never give this to a sensor.
OPERATOR_KEY=dev-operator-key-change-me

# Postgres connection for running the hub NATIVELY against the compose database.
# Port 5433 is the host mapping in docker-compose.yml (POSTGRES_PORT) — chosen
# because a locally-installed Postgres usually already owns 5432, and pointing at
# the wrong server surfaces as a puzzling "authentication failed".
# Inside Docker the hub uses `postgres:5432` instead; compose sets that itself.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/security?schema=public

# --- Optional (defaults shown) ---------------------------------------------

PORT=3000

# Liveness. Agents beat every HEARTBEAT_INTERVAL_MS; an agent is declared offline
# after HEARTBEAT_TIMEOUT_MS of silence (30s = three missed beats), detected by a
# sweep running on LIVENESS_SWEEP_CRON.
#
# Worst-case detection latency = TIMEOUT + sweep interval = 35s, typical ~32s.
# Set HEARTBEAT_TIMEOUT_MS=25000 for a hard 30s ceiling.
# The hub refuses to start if TIMEOUT <= INTERVAL, which would sweep healthy
# agents offline between beats.
HEARTBEAT_INTERVAL_MS=10000
HEARTBEAT_TIMEOUT_MS=30000
LIVENESS_SWEEP_CRON=*/5 * * * * *

# Window in which a repeat alert of the same (type, agent) is suppressed. Without
# this a motion sensor polling once a second produces 60 alerts a minute.
# Acknowledged alerts never suppress — the next trip is real news.
ALERT_COOLDOWN_MS=60000

# GET /events and GET /alerts pagination.
EVENTS_PAGE_LIMIT=50
EVENTS_PAGE_MAX=200

# WebSocket CORS: `*`, or a comma-separated origin list for a real dashboard.
CORS_ORIGIN=*
