# Copy to hub/.env for running the hub directly (outside Docker).
# Docker Compose reads the ROOT .env instead — see ../.env.example.

# --- Required ---------------------------------------------------------------

# Credentials are split by role (roadmap item 2). All travel as
# `Authorization: Bearer <credential>`. The two below MUST differ — reusing one
# secret for both would give every agent host operator privileges, and the hub
# refuses to start in that case.

# Provisioning secret. Authorises POST /agents/register and NOTHING else.
# Every agent host needs it. In exchange for a token, each agent can then act only
# as itself: it cannot forge events for other sensors, arm/disarm, acknowledge
# alerts, or read history.
AGENT_BOOTSTRAP_KEY=dev-bootstrap-key-change-me

# Operator credential: arm/disarm, acknowledge alerts, read events/alerts/agents,
# and subscribe to the WebSocket feed. Never give this to a sensor.
OPERATOR_KEY=dev-operator-key-change-me

# --- Optional human roles ---------------------------------------------------
# Both optional: leave a key unset and that role simply does not exist.
# Every configured credential must be distinct — a duplicate silently collapses two
# roles into one, and the hub refuses to start.

# Read-only. Cannot acknowledge, arm, or disarm.
VIEWER_KEY=dev-viewer-key-change-me

# Restricts the viewer to specific agent locations (comma-separated, case-insensitive).
# Empty means the whole building. This is the attribute-based half of the model: agents,
# events, and alerts outside these zones are filtered out by the hub's queries and by
# the WebSocket fan-out, not merely hidden in the UI.
#   e.g. VIEWER_ZONES=Hallway,Lobby
VIEWER_ZONES=

# Admin. Everything an operator can do, plus the notification delivery audit and the
# override for disarming while a critical alert is unacknowledged.
ADMIN_KEY=dev-admin-key-change-me

# Postgres connection for running the hub NATIVELY against the compose database.
# Port 5433 is the host mapping in docker-compose.yml (POSTGRES_PORT) — chosen
# because a locally-installed Postgres usually already owns 5432, and pointing at
# the wrong server surfaces as a puzzling "authentication failed".
# Inside Docker the hub uses `postgres:5432` instead; compose sets that itself.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/security?schema=public

# --- Optional (defaults shown) ---------------------------------------------

PORT=3000

# Liveness. Agents beat every HEARTBEAT_INTERVAL_MS; an agent is declared offline
# after HEARTBEAT_TIMEOUT_MS of silence (30s = three missed beats), detected by a
# sweep running on LIVENESS_SWEEP_CRON.
#
# Worst-case detection latency = TIMEOUT + sweep interval = 35s, typical ~32s.
# Set HEARTBEAT_TIMEOUT_MS=25000 for a hard 30s ceiling.
# The hub refuses to start if TIMEOUT <= INTERVAL, which would sweep healthy
# agents offline between beats.
HEARTBEAT_INTERVAL_MS=10000
HEARTBEAT_TIMEOUT_MS=30000
LIVENESS_SWEEP_CRON=*/5 * * * * *

# Window in which a repeat alert of the same (type, agent) is suppressed. Without
# this a motion sensor polling once a second produces 60 alerts a minute.
# Acknowledged alerts never suppress — the next trip is real news.
ALERT_COOLDOWN_MS=60000

# GET /events and GET /alerts pagination.
EVENTS_PAGE_LIMIT=50
EVENTS_PAGE_MAX=200

# WebSocket CORS: `*`, or a comma-separated origin list for a real dashboard.
CORS_ORIGIN=*

# --- Retention -------------------------------------------------------------
#
# 0 means KEEP FOREVER, and every window ships that way. Deletion is something you
# opt into: upgrading must never silently start destroying evidence.
#
# Hourly rollups run regardless of these settings, so the activity history is being
# summarised from the moment you upgrade — an event is never deleted until its hour
# has been counted into EventRollup.

# When the sweep runs. 6-field cron; defaults to 03:30 daily, away from the other sweeps.
RETENTION_SWEEP_CRON=0 30 3 * * *

# Raw sensor events. The highest-volume table by far — around 460 bytes a row
# including indexes — and the one worth a window. Try 30.
RETENTION_EVENT_DAYS=0

# ACKNOWLEDGED alerts only. An unacknowledged alert is never deleted at any age:
# it is unfinished business, and ageing one out silently closes an incident nobody
# handled. Try 90.
RETENTION_ALERT_DAYS=0

# Delivery records. Must be >= RETENTION_ALERT_DAYS (validated at boot), or you keep
# alerts you can no longer answer "was anyone actually told?" for. Pending rows are
# never deleted — that queue belongs to the retry worker.
RETENTION_NOTIFICATION_DAYS=0

# The audit trail: who armed, who acknowledged, who was refused. Set this LONGEST if
# you set it at all — it is the smallest table here and its entire value is how far
# back it reaches, so a short window destroys the feature to save nothing. Try 365.
RETENTION_AUDIT_DAYS=0

# Rows per DELETE, and the ceiling on batches per sweep. Small statements let sensor
# ingestion interleave with housekeeping; the cap drains a huge first prune over
# successive nights instead of competing for hours on one.
RETENTION_BATCH_SIZE=1000
RETENTION_MAX_BATCHES=50
RETENTION_BATCH_PAUSE_MS=100

# --- Scheduled arming ------------------------------------------------------
#
# Schedules themselves are created through the dashboard; these only tune the
# evaluator. A schedule fires ONCE when its boundary passes and then leaves the system
# alone — it will not fight an operator who deliberately disarmed, but the next
# boundary still arrives.

# How often boundaries are checked. 30s keeps worst-case lateness under a minute.
SCHEDULE_TICK_CRON=*/30 * * * * *

# How late a boundary may be and still fire, in minutes. Covers "the hub was down"
# without acting on a stale boundary: disarming a building at 13:00 because a 07:00
# schedule was missed lowers protection at a time nobody chose. Past this, the miss is
# recorded in the audit trail and the schedule left alone until tomorrow.
SCHEDULE_GRACE_MINUTES=60
