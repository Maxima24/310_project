// Schema lives in `hub/` rather than a `packages/db` workspace because the hub
// is the only DB consumer. A separate package would add a build step and
// generated-client resolution problems inside the Docker image for no gain.
//
// Enum string values MUST match packages/contracts/src/*.ts exactly — those are
// the wire format, and Postgres will reject anything else.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentType {
  motion
  door
  camera
}

enum AgentStatus {
  online
  offline
}

/// Where an agent's data physically comes from.
///
/// A hub-set column rather than a value in `capabilities`, because that array is free text
/// the agent sends about itself and a security-relevant marker cannot be self-reported.
/// Orthogonal to `type`: a browser is a different SOURCE for a camera, not a new kind of
/// sensor, and folding it into `type` would break every `type = 'camera'` filter.
enum AgentOrigin {
  device
  browser
}

enum SystemMode {
  disarmed
  home
  away
}

enum EventType {
  motion_detected
  door_opened
  door_closed
  camera_motion
}

enum AlertType {
  intrusion_motion
  intrusion_door
  camera_motion
  agent_offline
  agent_recovered
}

enum AlertSeverity {
  info
  warning
  critical
}

/// A collector agent. `id` is the operator-chosen string the agent sends
/// (e.g. "motion-hallway") rather than a surrogate key, so an agent restart
/// upserts onto the same row instead of orphaning its history.
model Agent {
  id           String      @id
  type         AgentType
  location     String
  status       AgentStatus @default(online)
  version      String?
  capabilities String[]    @default([])
  registeredAt DateTime    @default(now())
  /// SHA-256 of the agent's bearer token. Only the hash is stored, so a database
  /// dump does not hand over working credentials and a lost token can only be
  /// rotated, never recovered. Unique because it is the lookup key on every request.
  tokenHash      String?   @unique
  tokenIssuedAt  DateTime?
  /// Null means the token never expires, which is right for a dedicated device that
  /// should keep working unattended. Browser cameras get a short one: a publishing
  /// credential that outlives the person who created it is a camera nobody chose to run.
  tokenExpiresAt DateTime?
  /// Hub-set. Defaults to `device`, so every pre-existing row is correct with no backfill.
  origin         AgentOrigin @default(device)
  /// Count of re-enrollments. Legitimate when an agent loses its token file, but
  /// also exactly what someone holding the bootstrap key would cause, so it is
  /// recorded rather than silently overwritten.
  tokenRotations Int       @default(0)
  /// Written on every heartbeat AND every event — an event is proof of life too.
  /// This is the liveness source of truth; Redis is roadmap, not needed at this scale.
  lastSeenAt   DateTime    @default(now())

  events Event[]
  alerts Alert[]

  /// Exactly matches the liveness sweep predicate: status = 'online' AND lastSeenAt < cutoff.
  @@index([status, lastSeenAt])
}

enum NotificationChannel {
  email
  webhook
  log
}

enum NotificationStatus {
  sent
  failed
  pending
  skipped
}

/// One delivery attempt of one alert to one channel.
///
/// Persisted rather than fire-and-forget so a failed send is retryable and an
/// operator can answer "was anyone actually told?" — an alarm that silently failed
/// to notify is indistinguishable from one that never fired.
model Notification {
  id        String              @id @default(uuid())
  alertId   String
  alert     Alert               @relation(fields: [alertId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  status    NotificationStatus  @default(pending)
  attempts  Int                 @default(0)
  error     String?
  createdAt DateTime            @default(now())
  deliveredAt DateTime?
  /// When the retry worker should next try. Null once terminal.
  nextAttemptAt DateTime?

  /// One row per (alert, channel): the unique constraint is what makes delivery
  /// idempotent if a retry and a fresh dispatch race.
  @@unique([alertId, channel])
  /// Drives the retry sweep.
  @@index([status, nextAttemptAt])
}

/// A raw sensor observation. Facts only — no policy judgement.
model Event {
  id       String    @id @default(uuid())
  agentId  String
  agent    Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type     EventType
  /// Free-form detail: contour area today, a clip URL later (roadmap item 5).
  metadata Json      @default("{}")
  /// Agent-side clock. Informational — do not order by this.
  occurredAt DateTime
  /// Hub-side clock. Authoritative for ordering, immune to agent clock skew.
  createdAt  DateTime @default(now())
  alerts Alert[]
  @@index([createdAt(sort: Desc)])
  @@index([agentId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
}

/// A hub judgement produced by the alert rules.
model Alert {
  id       String        @id @default(uuid())
  type     AlertType
  severity AlertSeverity
  message  String
  /// Nullable because a future system-level alert may not belong to one agent.
  agentId  String?
  agent    Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  /// Null for agent_offline / agent_recovered — those come from the sweep, not an event.
  eventId  String?
  event    Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  /// The arm mode that produced this alert — the reason it exists at all.
  modeAtTrigger  SystemMode
  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  notifications Notification[]

  @@index([createdAt(sort: Desc)])
  @@index([acknowledged, createdAt(sort: Desc)])
  /// Serves the dedup lookup: same (type, agent), still unacknowledged, within the cooldown.
  @@index([type, agentId, acknowledged, createdAt(sort: Desc)])
}

/// Hourly counts, written before raw events are pruned.
///
/// Solves the real problem behind "can we compress history": raw events are ~460 bytes
/// each including indexes, and this system writes thousands a day forever. Rolling an
/// hour of one agent's one event type into a single counted row is roughly a 16x
/// reduction on observed data, and unlike an embedding it is exact for the question it
/// answers — "how much activity, where, when" — which is what every historical view
/// actually asks. It is deliberately NOT a lossy approximation of individual events:
/// those either exist in full or have been deleted, with nothing in between pretending
/// otherwise.
///
/// Kept forever by default. At 3 agents and 4 event types this is at most ~288 rows a
/// day even if every combination fires every hour.
model EventRollup {
  id      String    @id @default(uuid())
  /// Start of the hour, UTC, truncated. The bucket key.
  hour    DateTime
  agentId String
  type    EventType
  count   Int

  /// One row per bucket, which is what makes the rollup writer idempotent — a retry or
  /// an overlapping sweep increments rather than duplicating.
  @@unique([hour, agentId, type])
  @@index([hour(sort: Desc)])
}

/// A scheduled arm or disarm.
///
/// Fires ONCE at its boundary and then leaves the system alone — see the contract for
/// why a continuously enforced state would be the wrong model here.
model ArmSchedule {
  id      String     @id @default(uuid())
  name    String
  enabled Boolean    @default(true)
  mode    SystemMode

  /// 0 = Sunday. Empty means every day.
  daysOfWeek Int[] @default([])
  /// Minutes from local midnight, 0-1439. An integer rather than "HH:MM" so the
  /// database cannot hold a value the evaluator fails to parse at 03:00.
  startMinute Int
  /// IANA zone. Stored per schedule rather than inferred: the hub container runs UTC,
  /// and a fixed offset would be an hour wrong for half the year.
  timezone String

  /// Local date (YYYY-MM-DD) this last fired for, and when.
  ///
  /// This is the idempotency key, and it is keyed on LOCAL date rather than a UTC
  /// instant so that "today's 07:00 arm" means the same thing across a DST boundary.
  /// A conditional update on this column is what stops an overlapping tick, a hub
  /// restart, or a second instance firing the same schedule twice.
  lastFiredFor String?
  lastFiredAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The evaluator scans enabled schedules on every tick.
  @@index([enabled])
}

enum AuditActor {
  bootstrap
  agent
  viewer
  operator
  admin
  /// The hub acting on its own — a scheduled transition has no operator behind it.
  system
}

enum AuditAction {
  mode_changed
  alert_acknowledged
  agent_enrolled
  agent_token_rotated
  camera_viewed
  schedule_fired
  browser_camera_provisioned
  browser_camera_revoked
}

enum AuditOutcome {
  allowed
  denied
}

/// Who did what, and whether it was allowed.
///
/// Deliberately holds NO credential material, not even a hash. Agent tokens are
/// 256-bit random values and their hashes are safe at rest, but the human credentials
/// are operator-chosen strings with an 8-character floor — hashing one into this table
/// would put a crackable copy of a secret into the database for the first time, and
/// the only thing it would buy is telling two holders of the SAME key apart, which it
/// cannot do anyway. What the hub genuinely knows is the role, and for agent tokens
/// the agent. That is what is stored.
model AuditLog {
  id      String       @id @default(uuid())
  at      DateTime     @default(now())
  action  AuditAction
  outcome AuditOutcome

  /// VERIFIED: established from the credential presented.
  actor        AuditActor
  /// VERIFIED: set only for agent tokens, which are issued per agent.
  actorAgentId String?
  /// UNVERIFIED: a self-asserted display name from the X-Operator-Label header.
  /// Anyone holding the credential can send any name. Never treat as identity.
  actorLabel   String?

  /// Why a denial happened, in the same words the caller was given.
  reason     String?
  targetType String?
  targetId   String?
  detail     Json    @default("{}")
  /// The proxy's address rather than the client's unless the hub trusts its proxy.
  ip         String?

  @@index([at(sort: Desc)])
  @@index([action, at(sort: Desc)])
  /// Serves the query that matters most: "what was refused, most recent first".
  @@index([outcome, at(sort: Desc)])
}

/// Singleton row (id is always 1). A typed enum column beats a generic
/// key/value settings table here: Postgres rejects an invalid mode outright and
/// there is no string parsing at the call site. Mode is the only setting the
/// system defines.
model SystemState {
  id        Int        @id @default(1)
  mode      SystemMode @default(disarmed)
  updatedAt DateTime   @updatedAt
}
