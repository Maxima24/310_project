# Run `pre*`/`post*` npm scripts (pnpm does not by default) so `prebuild` /
# `postinstall` hooks in THIS repo's package.json behave the way npm users expect.
# Note this is unrelated to dependency install scripts — those are governed by
# `pnpm.onlyBuiltDependencies` in package.json.
enable-pre-post-scripts=true

# NestJS ships wide peer ranges across its @nestjs/* packages; treating a peer
# mismatch as fatal blocks installs for no real benefit on a project this size.
strict-peer-dependencies=false
auto-install-peers=true

# Fail the install when the running pnpm/Node falls outside `engines`, rather than
# producing a subtly broken tree. The lockfile is version 9.0, which pnpm 8 cannot
# read at all, so catching it here gives a clear message instead of
# ERR_PNPM_LOCKFILE_BREAKING_CHANGE halfway through CI.
engine-strict=true
