# Copy to .env at the repo root. Docker Compose reads this file.
# Running the hub natively instead? Use hub/.env — see hub/.env.example.

# Credentials, split by role (roadmap item 2). Must differ from each other.
# Agents get AGENT_BOOTSTRAP_KEY (enrollment only) and are issued their own token.
# Humans and the dashboard use OPERATOR_KEY.
AGENT_BOOTSTRAP_KEY=dev-bootstrap-key-change-me
OPERATOR_KEY=dev-operator-key-change-me

# Optional human roles. VIEWER_KEY is read-only and can be limited to specific agent
# locations with VIEWER_ZONES; ADMIN_KEY adds the notification audit and the override
# for disarming during an unacknowledged critical alert.
VIEWER_KEY=dev-viewer-key-change-me
VIEWER_ZONES=
ADMIN_KEY=dev-admin-key-change-me

# Postgres credentials for the compose `postgres` service.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=security

# Host port the compose Postgres is published on. Deliberately not 5432 — a
# locally-installed Postgres usually owns that, and pointing the hub at the wrong
# server produces a confusing auth failure. Containers use `postgres:5432` and
# ignore this.
POSTGRES_PORT=5433

# Host port the hub is published on.
HUB_PORT=3000

# Liveness / alert tuning — see hub/.env.example for what each one means.
HEARTBEAT_INTERVAL_MS=10000
HEARTBEAT_TIMEOUT_MS=30000
ALERT_COOLDOWN_MS=60000

# Retention. 0 = keep forever, which is the shipped default — nothing is ever deleted
# until you set a window here. Hourly rollups run either way, so history is summarised
# from the start. See hub/.env.example for the rules each window obeys.
RETENTION_EVENT_DAYS=0
RETENTION_ALERT_DAYS=0
RETENTION_NOTIFICATION_DAYS=0
RETENTION_AUDIT_DAYS=0

# Scheduled arming: how late a boundary may be and still fire, in minutes. Schedules
# themselves are created in the dashboard under Settings.
SCHEDULE_GRACE_MINUTES=60
