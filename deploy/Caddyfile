# Reverse proxy and static host for the security hub.
#
# One file serves both shapes, chosen by SITE_ADDRESS:
#
#   SITE_ADDRESS=:80                 -> plain HTTP on localhost, no certificate friction
#   SITE_ADDRESS=hub.example.com     -> automatic HTTPS via Let's Encrypt
#   SITE_ADDRESS=https://hub.example.com, https://www.hub.example.com  -> several names
#
# Caddy provisions and renews certificates itself when the address is a real hostname,
# which is the whole reason for putting it in front rather than nginx.
#
# Everything is served from ONE origin: the dashboard at /, the hub under /api, and the
# WebSocket at /socket.io. That removes CORS entirely and keeps the operator credential
# same-site — a split-origin deployment (see render.yaml) has to loosen both.
{
	# Where Let's Encrypt sends expiry warnings. Ignored for local (:80) addresses.
	email {$ACME_EMAIL:admin@example.com}

	# Uncomment while testing certificate issuance — the staging endpoint has far
	# higher rate limits, so a misconfigured domain cannot get you blocked for a week.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$SITE_ADDRESS::80} {
	log {
		output stdout
		format console
	}

	# Compress before it leaves the proxy. The event feed is JSON and compresses well.
	#
	# The match list is NOT optional decoration. `multipart/x-mixed-replace` — the live
	# camera stream — must never be compressed: a compressor buffers, and a buffered
	# live view arrives in bursts seconds late, which on a security console is worse
	# than no picture because it looks current. Caddy's default allowlist happens to
	# exclude that type today, so this used to work by luck; naming the types we DO
	# want makes the guarantee explicit and survives a Caddy upgrade.
	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/wasm*
			header Content-Type image/svg+xml*
		}
	}

	# --- WebSocket -----------------------------------------------------------
	# Must come BEFORE the /api rule and must NOT strip its prefix: socket.io needs
	# the path intact, and Caddy passes Upgrade/Connection headers through for
	# handle_path/reverse_proxy automatically.
	handle /socket.io/* {
		reverse_proxy hub:3000
	}

	# --- REST API ------------------------------------------------------------
	# handle_path strips the matched prefix, so /api/agents reaches the hub as
	# /agents. The dashboard's default VITE_API_BASE of "/api" relies on exactly this,
	# as does the Vite dev proxy, so the two behave identically.
	handle_path /api/* {
		reverse_proxy hub:3000 {
			# Without these the hub logs every request as coming from the proxy, which
			# makes the guard's rejection warnings useless for tracing an attacker.
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}

			# Flush every write straight through. Caddy auto-detects text/event-stream
			# but not multipart/x-mixed-replace, so without this the MJPEG camera feed
			# is at the mercy of default buffering. -1 means "no buffering at all".
			flush_interval -1
		}
	}

	# --- Dashboard: hashed assets --------------------------------------------
	#
	# Handled separately from the app document, and NOT covered by the SPA fallback
	# below. That distinction is the whole point: a bundle filename contains a content
	# hash, so a request for one that no longer exists means the caller is working from
	# a stale document and the honest answer is 404. Letting it fall through to
	# try_files returns index.html with a 200 instead, and the browser then tries to
	# parse a web page as JavaScript — which fails silently and presents as an app that
	# loads but does nothing.
	handle /assets/* {
		root * /srv
		# Immutable by construction: the content hash is in the name.
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# --- Dashboard: the app document -----------------------------------------
	handle {
		root * /srv

		# Applied to the RESPONSE for every client-side route, not just the literal
		# /index.html. Matching on the filename was wrong: browsers request `/`, which
		# never matched, so the document was served with no cache directive at all and
		# heuristically cached — pinning people to a bundle that a deploy had removed.
		header Cache-Control "no-cache"

		# Single-page app: unknown paths are client-side routes, not 404s.
		try_files {path} /index.html
		file_server
	}

	# Sensible defaults for a security console. HSTS is deliberately omitted here —
	# it is only meaningful on HTTPS and would strand a local :80 setup.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}
